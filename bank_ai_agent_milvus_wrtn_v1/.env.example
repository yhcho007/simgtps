# .env.example
# 이 파일을 .env 로 복사하고 필요한 값을 채워주세요.

# --- Vector DB 선택 설정 ---
# OS에 따라 기본값: Windows는 Chroma, Linux는 Milvus.
# 직접 지정하려면 "milvus" 또는 "chroma"로 설정하세요. (예: VECTOR_DB=chroma)
VECTOR_DB=

# Milvus 설정 (Linux 환경용)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=bank_faq_collection
MILVUS_NLIST=128
MILVUS_NPROBE=10

# ChromaDB 설정 (Windows 환경용)
CHROMA_DB_PATH=./chroma_data
CHROMA_COLLECTION_NAME=bank_faq_collection

# 임베딩 모델 관련 설정
OPENAI_API_KEY=sk-your_openai_api_key_here
EMBEDDING_MODEL_NAME=text-embedding-3-small
FORCE_LOCAL_EMBEDDING=True # True면 OpenAI 키가 있어도 로컬 모델 사용 강제
LOCAL_EMBEDDING_MODEL_PATH=./models/snunlp-SKT-KR-KoBERT-Large-vocab
USE_GPU=False # 로컬 임베딩 모델에서 GPU를 사용할지 여부 (True 또는 False)

# Milvus 및 ChromaDB 컬렉션 필드 설정 (로컬 임베딩 모델 차원에 맞춰 조정)
# KoBERT Large 모델은 일반적으로 768 차원입니다.
MILVUS_DIM=768

# --- 구글 로그인 (OAuth2) 설정 ---
# Google Cloud Console에서 프로젝트 생성 후 'API 및 서비스' -> '사용자 인증 정보'에서
# OAuth 클라이언트 ID를 생성하고 웹 애플리케이션 타입을 선택하여 발급받으세요.
# 리디렉션 URI에는 'http://localhost:8000/auth/google/callback'을 추가해야 합니다.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SECRET_KEY=your_super_secret_key_for_jwt_and_sessions_CHANGEME_IN_PRODUCTION! # 반드시 변경!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30